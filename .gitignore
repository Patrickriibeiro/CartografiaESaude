# Dados brutos e intermediários nunca entram no git (trilha §3.3, invariante 1; LGPD)
dados/brutos/*
dados/intermediarios/*
# Processados são regeneráveis pelo pipeline; sivep_* teria fichas individuais
dados/processados/*
!dados/**/.gitkeep

# Saídas regeneráveis
resultados/mapas/*
resultados/objetos/*
!resultados/**/.gitkeep
*_files/
08_relatorio.html
08_apresentacao.html
.quarto/

# R e editores
.Rhistory
.RData
.Rproj.user/
renv/library/
renv/staging/
renv/local/

/.quarto/
**/*.quarto_ipynb
resultados/execucao.log

# Proposta original (PDF da autora): fica só na máquina, fora do repositório (D-01, CS-026)
/23092026_*.pdf

# Claude Code: preferências locais de cada máquina (as do projeto ficam em .claude/settings.json)
.claude/settings.local.json
